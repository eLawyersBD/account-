rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidConsultationRequest(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() > 0 && data.email.size() <= 100
        && data.createdAt is timestamp;
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.category is string
        && data.excerpt is string && data.excerpt.size() <= 500
        && data.content is string
        && data.author is string && data.author.size() <= 100
        && data.createdAt is timestamp;
    }

    match /consultation_requests/{requestId} {
      allow create: if isValidId(requestId) 
        && isValidConsultationRequest(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create: if isValidId(articleId)
        && isValidArticle(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
